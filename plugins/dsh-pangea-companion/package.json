{
  "name": "dsh-pangea-companion",
  "version": "0.10.0",
  "description": "PANGEA companion for DeepSeek Harness with analysis browsing, executor environments, host-plus-array SSH execution, and workspace-scoped report wake control",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./report-policy": "./src/report-policy.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pangea-agent",
    "companion",
    "dsh-pangea"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "dsh-pangea": ">=0.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "npm run build && node --check src/index.js && node --check src/pangea-api.js && node --check src/reader.js && node --check src/source.js && node --check src/monitor.js && node --check src/report-policy.js && node --check lib/client.js && node --test tests/*.test.mjs"
  }
}

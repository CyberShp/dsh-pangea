{
  "name": "dsh-pangea-asset-catalog",
  "version": "0.1.0",
  "description": "PANGEA asset management and structured extraction for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "deepseek-harness",
    "dsh",
    "pangea-agent",
    "asset-catalog",
    "asset-management"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "dsh-pangea": ">=0.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "react": { "optional": true }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "npm run build && node --check src/pangea-api.js && node --check src/index.js && node --check lib/client.js && node --test tests/*.test.mjs"
  }
}

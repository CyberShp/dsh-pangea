{
  "name": "dsh-pangea-run-ui",
  "version": "0.1.0",
  "description": "PANGEA run workflow presentation, isolated assistant sessions, and persisted Agent output viewer",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "lib", "scripts", "tests", "README.md"],
  "license": "UNLICENSED",
  "private": true,
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "react": { "optional": true }
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "npm run build && node --check src/index.js && node --check lib/client.js && node --test tests/*.test.mjs"
  }
}
